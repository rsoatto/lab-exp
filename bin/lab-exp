#!/usr/bin/env python3
"""lab-exp — structure a project for agentic experimentation.

One shared importable package (methods/models/loops/viz) + append-only experiments/,
each experiment a directory with README (hypothesis, method, how-to-run) + run.py + out/.
A registry TSV is the agent-facing truth; wandb is the human layer; lab-report composes
lib/viz renders into published pages. Stamping happens from OUTSIDE the experiment
process, so projects never import this framework and `python run.py` always works bare.

  lab-exp init [--package PKG]        # adopt in the current project root (additive)
  lab-exp new <slug> --kind K [--tags k:v,..] [--based-on ID] [--title T]
  lab-exp run <ID> [--gpus N] [--time T] [--partition P] [--dry-run] [-- args...]
  lab-exp done <ID> [--status done|failed|abandoned] [--finding "..."] [--metrics k=v,..]
  lab-exp list [--kind K] [--tag k:v] [--status S]
  lab-exp viz <ID> [<name>]           # list / run applicable visualizers -> out/viz/
  lab-exp serve <name> <ID...> | serve --list | serve --stop <port>
  lab-exp index                       # regenerate <pkg>/INDEX.md (methods + visualizers)
  lab-exp doctor                      # drift checks (warn, never block)
  lab-exp projects                    # all lab-exp projects on this machine

Per-project knobs live in .lab-exp.toml (written by init, edited by hand, never guessed).
Registry columns: id date kind status agent host git_sha based_on tags metrics finding wandb superseded_by notes
"""
import argparse
import ast
import base64
import contextlib
import errno
import fcntl
import fnmatch
from collections import deque
import html as _html
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from datetime import date, datetime, timedelta, timezone
from pathlib import Path

CONFIG_NAME = ".lab-exp.toml"
REG_COLS = ["id", "date", "kind", "status", "agent", "host", "git_sha",
            "based_on", "tags", "metrics", "finding", "wandb", "superseded_by", "notes"]
# superseded_by (2026-08) / notes (2026-09) appended at the end: reg_read pads short rows, so old
# registries need no migration. notes is README-owned (like title): never in FRONT_KEYS below, so
# reg_sync/front_mirror never write it back -- it flows README -> registry only, one-way.
# Machine-local state -> ~/.config/lab (NOT ~/lab, which is rsync-deployed from the laptop: a
# registry living there gets clobbered by every deploy and leaks one machine's projects onto another).
PROJECTS_TSV = Path.home() / ".config" / "lab" / "exp-projects.tsv"
SERVES_TSV = Path.home() / ".config" / "lab" / "exp-serves.tsv"
WANDB_ENV = Path.home() / ".config" / "lab" / "wandb.env"
# Change signal for the hub publisher (lab-exp-hub): every registry write drops a fresh token
# here; the publisher republishes when the token differs from the one it last published. A
# token, not an mtime: the fleet's clocks disagree by up to an hour, and on the NFS home this
# one file is shared by every box.
HUB_DIRTY = Path.home() / ".config" / "lab" / "hub.dirty"


# ---------------------------------------------------------------- config

def parse_toml(text):
    """tomllib when available (py>=3.11), else a minimal parser for the subset
    init writes: [a.b] sections, str/int/bool values, arrays of strings."""
    try:
        import tomllib
        return tomllib.loads(text)
    except ImportError:
        pass
    out, cur = {}, None
    for raw in text.splitlines():
        line = raw.split("#", 1)[0].strip() if not raw.strip().startswith('"') else raw.strip()
        if not line:
            continue
        if line.startswith("["):
            cur = out
            for part in line.strip("[]").split("."):
                cur = cur.setdefault(part.strip(), {})
            continue
        if "=" not in line:
            continue
        k, v = [x.strip() for x in line.split("=", 1)]
        if v.startswith("["):
            val = [x.strip().strip('"').strip("'") for x in v.strip("[]").split(",") if x.strip()]
        elif v in ("true", "false"):
            val = v == "true"
        elif v.strip('"') != v or v.strip("'") != v:
            val = v.strip('"').strip("'")
        else:
            try:
                val = int(v)
            except ValueError:
                val = v
        (cur if cur is not None else out)[k] = val
    return out


def find_root(start=None):
    p = Path(start or os.getcwd()).resolve()
    for d in [p] + list(p.parents):
        if (d / CONFIG_NAME).is_file():
            return d
    die(f"no {CONFIG_NAME} found from {p} upward — run `lab-exp init` at the project root")


def load_cfg(root):
    cfg = parse_toml((root / CONFIG_NAME).read_text())
    cfg.setdefault("project", {})
    cfg.setdefault("paths", {})
    cfg.setdefault("env", {})
    cfg.setdefault("run", {})
    cfg.setdefault("wandb", {})
    cfg.setdefault("links", {})
    return cfg


def pkg_dir(root, cfg):
    return root / cfg["project"].get("package", "lib")


def die(msg, code=1):
    print(f"lab-exp: {msg}", file=sys.stderr)
    sys.exit(code)


def warn(msg):
    print(f"  WARN {msg}")


# ---------------------------------------------------------------- registry

def reg_path(root):
    return root / "experiments" / "_registry.tsv"


def reg_read(root, derive=True):
    """Registry rows. The TSV is a CACHE of facts that live in each experiment's README
    front-matter (see front_update/row_from_readme): any experiment directory with front-matter
    but no cached row is derived on the fly, so a collaborator's hand-made experiment, or a fresh
    clone where the TSV is gitignored, is visible to every command without a rebuild step.
    derive=False returns the cache alone (doctor uses it to report what is derived-only)."""
    rows = []
    f = reg_path(root)
    if f.is_file():
        for line in f.read_text().splitlines()[1:]:
            if not line.strip():
                continue
            vals = line.split("\t")
            vals += [""] * (len(REG_COLS) - len(vals))
            rows.append(dict(zip(REG_COLS, vals)))
    if derive:
        have = {r["id"] for r in rows}
        for d in exp_dirs(root):
            if d.name not in have:
                r = row_from_readme(d)
                if r:
                    rows.append(r)
    return rows


def exp_dirs(root):
    exps = root / "experiments"
    if not exps.is_dir():
        return []
    return sorted(p for p in exps.iterdir() if p.is_dir() and not p.name.startswith("_"))


# Registry-owned facts that are mirrored into README front-matter on every registry write, and
# read back by row_from_readme. kind/tags/based_on are AUTHORED in the front-matter already.
FRONT_KEYS = ["status", "date", "agent", "host", "git_sha", "metrics", "finding", "wandb", "superseded_by"]


def front_update(readme, updates):
    """Additive edit of a README's front-matter block: set or replace `key: value` lines, drop a
    key whose value is empty. The body is never touched; a README without front-matter is left
    alone (returns False). This is the ONE writer of registry facts into READMEs."""
    if not readme.is_file():
        return False
    lines = readme.read_text().splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        return False
    end = next((i for i in range(1, len(lines)) if lines[i].strip() == "---"), None)
    if end is None:
        return False
    block = [l if l.endswith("\n") else l + "\n" for l in lines[1:end]]
    changed = False
    for k, v in updates.items():
        v = "" if v is None else str(v).replace("\n", " ").replace("\t", " ").strip()
        idx = next((i for i, l in enumerate(block) if ":" in l and l.split(":", 1)[0].strip() == k), None)
        if v == "":
            if idx is not None:
                block.pop(idx)
                changed = True
            continue
        new = f"{k}: {v}\n"
        if idx is None:
            block.append(new)
            changed = True
        elif block[idx] != new:
            block[idx] = new
            changed = True
    if changed:
        readme.write_text("".join(lines[:1] + block + lines[end:]))
    return changed


def front_mirror(root, row, full=False):
    """Mirror a registry row's facts into its README. full=False (upsert semantics) writes only
    non-empty facts; full=True (reg_edit semantics) also REMOVES keys the row has cleared and
    rewrites tags (that is how `important` toggles reach the README)."""
    readme = root / "experiments" / row["id"] / "README.md"
    upd = {k: row.get(k, "") for k in FRONT_KEYS if full or row.get(k, "")}
    if full:
        fm = read_front(readme)
        if set(split_list(fm.get("tags", ""))) != set(split_list(row.get("tags", ""))):
            upd["tags"] = ", ".join(split_list(row.get("tags", ""))) or "none"
    return front_update(readme, upd)


def result_recorded(readme):
    """True when the README's `## Result` section has real content (not just the template
    comment) -- the signal that a hand-made experiment is finished."""
    if not readme.is_file():
        return False
    txt = readme.read_text()
    m = re.search(r"^## Result[^\n]*\n(.*?)(?=^## |\Z)", txt, re.S | re.M)
    if not m:
        return False
    body = re.sub(r"<!--.*?-->", "", m.group(1), flags=re.S)
    return bool(body.strip())


def metrics_from_json(d):
    f = d / "out" / "metrics.json"
    try:
        data = json.loads(f.read_text())
    except (OSError, ValueError):
        return ""
    if not isinstance(data, dict):
        return ""
    return ",".join(f"{k}={v}" for k, v in data.items()
                    if isinstance(v, (int, float)) and not isinstance(v, bool))


def row_from_readme(d):
    """A registry row derived purely from an experiment directory: README front-matter first,
    out/metrics.json for metrics when the front-matter has none. None when there is no
    front-matter (that IS the shared contract; doctor warns about it). Status is inferred for
    experiments that never went through lab-exp: done when a Result section or metrics exist,
    else unknown."""
    fm = read_front(d / "README.md")
    if not fm:
        return None
    row = {c: fm.get(c, "") for c in REG_COLS}
    row["id"] = d.name
    row["tags"] = ",".join(split_list(fm.get("tags", "")))
    row["based_on"] = ",".join(split_list(fm.get("based_on", "")))
    row["metrics"] = ",".join(split_list(fm.get("metrics", ""))) or metrics_from_json(d)
    if not row["date"]:
        m = re.match(r"(\d{4})(\d{2})(\d{2})-", d.name)
        row["date"] = f"{m[1]}-{m[2]}-{m[3]}" if m else ""
    if not row["status"]:
        row["status"] = "done" if (result_recorded(d / "README.md") or row["metrics"]) else "unknown"
    return row


def reg_rebuild(root):
    """Every row, derived from READMEs alone (what `registry --rebuild` writes)."""
    return [r for r in (row_from_readme(d) for d in exp_dirs(root)) if r]


def reg_sync(root, dry_run=False):
    """Push cached facts a README does not carry yet into its front-matter (additive: an existing
    front-matter value always wins; tags are unioned so `important` survives). This is the
    one-time migration for projects whose facts so far lived only in the TSV; afterwards every
    write mirrors itself. Returns [(id, keys_written)]."""
    out = []
    for r in reg_read(root, derive=False):
        readme = root / "experiments" / r["id"] / "README.md"
        fm = read_front(readme)
        if not fm:
            continue
        # Only facts the README cannot reproduce by itself. A cached row that a rebuild DERIVED
        # (status inferred from the Result section, date from the id, metrics from
        # out/metrics.json) must not be written back as if lab-exp had recorded it -- that put
        # `status: unknown` into a collaborator's hand-made README (scout-translation, 2026-09-16).
        derived = row_from_readme(readme.parent) or {}
        upd = {k: r[k] for k in FRONT_KEYS
               if r.get(k, "") and not fm.get(k, "") and r[k] != derived.get(k, "")}
        have, want = split_list(fm.get("tags", "")), split_list(r.get("tags", ""))
        extra = [t for t in want if t not in have]
        if extra:
            upd["tags"] = ", ".join(have + extra)
        if upd:
            out.append((r["id"], sorted(upd)))
            if not dry_run:
                front_update(readme, upd)
    return out


@contextlib.contextmanager
def reg_lock(root):
    # Serializes registry read-modify-write across concurrent lab-exp processes.
    lock = reg_path(root).with_suffix(".tsv.lock")
    lock.parent.mkdir(parents=True, exist_ok=True)
    with open(lock, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        yield


def reg_write(root, rows):
    f = reg_path(root)
    # PID-unique temp: two writers racing through one fixed temp path made the
    # loser's os.replace die with FileNotFoundError.
    tmp = f.with_suffix(f".tsv.tmp.{os.getpid()}")
    clean = lambda s: str(s).replace("\t", " ").replace("\n", " ")
    try:
        with open(tmp, "w") as fh:
            fh.write("\t".join(REG_COLS) + "\n")
            for r in rows:
                fh.write("\t".join(clean(r.get(c, "")) for c in REG_COLS) + "\n")
        os.replace(tmp, f)
    finally:
        tmp.unlink(missing_ok=True)
    hub_touch()


def hub_touch():
    try:
        HUB_DIRTY.parent.mkdir(parents=True, exist_ok=True)
        HUB_DIRTY.write_text(f"{os.urandom(8).hex()} {datetime.now(timezone.utc).isoformat(timespec='seconds')} "
                             f"{socket.gethostname().split('.')[0]}\n")
    except OSError:
        pass          # a missing signal costs a slower hub refresh, never a failed command


def reg_upsert(root, row):
    with reg_lock(root):
        rows = reg_read(root)
        for i, r in enumerate(rows):
            if r["id"] == row["id"]:
                rows[i] = merged = {**r, **{k: v for k, v in row.items() if v != ""}}
                break
        else:
            rows.append(merged := {c: row.get(c, "") for c in REG_COLS})
        reg_write(root, rows)
        front_mirror(root, merged)


# ---------------------------------------------------------------- experiments

def exp_dir(root, eid):
    d = root / "experiments" / eid
    if not d.is_dir():
        # allow slug-only reference if unambiguous
        hits = [p for p in (root / "experiments").iterdir()
                if p.is_dir() and not p.name.startswith("_") and p.name.endswith("-" + eid)]
        if len(hits) == 1:
            return hits[0]
        die(f"no experiment '{eid}' (and no unique slug match)")
    return d


# ---------------------------------------------------------------- checkouts (git worktrees)
# Orchestrators develop and launch runs from git WORKTREES of a project, each with its own
# .lab-exp.toml. An experiment made in one exists only there until its branch merges, and its out/
# (gitignored) never merges at all -- so the registered checkout alone shows a fraction of the work.
# The VIEW of a project is the union over its checkouts: one copy per experiment id, reports from
# whichever copy has them. Reads (hub, pages, notes) go through project_view(); writes go to
# view_entry()["root"], the checkout that owns the copy, so that checkout's own cache stays right.
# Nothing is ever copied between checkouts: a README placed in the registered checkout before its
# branch merges makes git refuse the next fast-forward ("untracked working tree files would be
# overwritten by merge").

STATUS_RANK = {"done": 3, "superseded": 3, "failed": 3, "abandoned": 3, "ran": 2, "running": 1, "planned": 0}


def project_name(root):
    return load_cfg(root)["project"].get("name") or Path(root).name


def checkouts(root):
    """[root] + the other git worktrees of root's repository that carry a .lab-exp.toml for the same
    project (at the same path inside the worktree as root sits in its own). Just [root] outside git."""
    root = Path(root).resolve()

    def git(*args):
        r = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, timeout=20)
        return r.stdout if r.returncode == 0 else ""
    try:
        top, listing = git("rev-parse", "--show-toplevel").strip(), git("worktree", "list", "--porcelain")
        rel = root.relative_to(Path(top).resolve()) if top else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return [root]
    if rel is None or not listing:
        return [root]
    try:
        name = project_name(root)
    except OSError:
        return [root]
    out = [root]
    for line in listing.splitlines():
        if not line.startswith("worktree "):
            continue
        try:
            w = (Path(line[len("worktree "):]) / rel).resolve()
            if w in out or not (w / CONFIG_NAME).is_file():
                continue
            if (load_cfg(w)["project"].get("name") or name) == name:
                out.append(w)
        except (OSError, ValueError):
            continue          # a worktree dir that vanished, or an unreadable config: not part of the view
    return out


def _nonempty_dir(p):
    try:
        return p.is_dir() and any(True for _ in p.iterdir())
    except OSError:
        return False


def view_index(root, cos=None):
    """{id: entry} over the union of a project's checkouts. entry = {"id", "root": the checkout that
    owns the chosen copy, "dir": that copy, "out": a non-empty out/ (the owner's when it has one,
    else the best other copy's) or None, "row": the owner's registry row}. One copy per id: an
    existing directory beats a cache-only row, then the most advanced status (terminal > ran >
    running > planned), then -- between copies whose READMEs differ -- the newer README; identical
    copies belong to the first checkout (the registered one)."""
    cos = cos or checkouts(root)
    cands = {}
    for co in cos:
        for r in reg_read(co):
            d = co / "experiments" / r["id"]
            try:
                mt = (d / "README.md").stat().st_mtime
            except OSError:
                mt = 0.0
            cands.setdefault(r["id"], []).append(((d.is_dir(), STATUS_RANK.get(r.get("status", ""), -1), mt), co, d, r))
    idx = {}
    first = cos[0]
    for eid, cs in cands.items():
        cs.sort(key=lambda c: c[0], reverse=True)
        _key, co, d, r = cs[0]
        # A tie on status between copies with IDENTICAL READMEs is the same experiment checked out
        # twice: the registered checkout owns it (a checkout's mtime is when git wrote the file, not
        # when anyone changed it). The newer README only wins between copies that really differ.
        top = [c for c in cs if c[0][:2] == cs[0][0][:2]]
        home = next((c for c in top if c[1] == first), None)
        if home is not None and home is not cs[0]:
            try:
                txt = (home[2] / "README.md").read_bytes()
                if all((c[2] / "README.md").read_bytes() == txt for c in top):
                    _key, co, d, r = home
            except OSError:
                pass
        out = next((c[2] / "out" for c in cs if _nonempty_dir(c[2] / "out")), None)
        idx[eid] = {"id": eid, "root": co, "dir": d, "out": out, "row": r}
    return idx


def view_entry(root, eid, idx=None):
    """The view's copy of one experiment (a full id, or the slug after the date when unambiguous).
    Raises ValueError (never die()s): the live server must survive a bad request."""
    idx = view_index(root) if idx is None else idx
    if eid in idx:
        return idx[eid]
    hits = [e for k, e in idx.items() if k.endswith("-" + eid)]
    if len(hits) == 1:
        return hits[0]
    raise ValueError(f"no experiment '{eid}' in any checkout (and no unique slug match)")


def view_ids(root):
    """Experiment directory names across every checkout (cheap: no README parsing)."""
    return sorted({d.name for co in checkouts(root) for d in exp_dirs(co)})


@contextlib.contextmanager
def project_view(root):
    """A root that reads as the whole project. With no other worktrees: root itself (zero cost).
    Otherwise a throwaway directory whose experiments/<id> are symlinks to the chosen copies (a small
    real directory of symlinks when the reports come from another copy), with a registry cache of
    the chosen rows, so the page, hub, report and notes code run unchanged on it. READ-ONLY: route
    writes to view_entry(root, id)["root"]."""
    root = Path(root).resolve()
    cos = checkouts(root)
    if len(cos) == 1:
        yield root
        return
    idx = view_index(root, cos)
    base = Path(tempfile.mkdtemp(prefix="lab-exp-view-"))
    v = base / root.name                  # same basename: a project without [project] name keeps its name
    try:
        v.mkdir()
        (v / CONFIG_NAME).symlink_to((root / CONFIG_NAME).resolve())
        ex = v / "experiments"
        ex.mkdir()
        for eid, e in idx.items():
            d = e["dir"]
            if not d.is_dir():
                continue
            if e["out"] is None or e["out"] == d / "out":
                (ex / eid).symlink_to(d)
            else:
                comp = ex / eid
                comp.mkdir()
                for child in d.iterdir():
                    if child.name != "out":
                        (comp / child.name).symlink_to(child)
                (comp / "out").symlink_to(e["out"])
        clean = lambda x: str(x).replace("\t", " ").replace("\n", " ")
        with open(reg_path(v), "w") as fh:        # written directly: reg_write would signal the hub (a loop)
            fh.write("\t".join(REG_COLS) + "\n")
            for e in sorted(idx.values(), key=lambda e: e["id"]):
                fh.write("\t".join(clean(e["row"].get(c, "")) for c in REG_COLS) + "\n")
        yield v
    finally:
        shutil.rmtree(base, ignore_errors=True)   # unlinks the symlinks; never follows them


def read_front(readme):
    """Parse the --- frontmatter block of an experiment README into a dict."""
    meta = {}
    if not readme.is_file():
        return meta
    lines = readme.read_text().splitlines()
    if not lines or lines[0].strip() != "---":
        return meta
    for line in lines[1:]:
        if line.strip() == "---":
            break
        if ":" in line:
            k, v = line.split(":", 1)
            meta[k.strip()] = v.strip()
    return meta


def split_list(s):
    return [x.strip() for x in re.split(r"[,\s]+", (s or "").strip().strip("[]"))
            if x.strip() and x.strip() != "none"]


def tags_dict(tag_list):
    d = {}
    for t in tag_list:
        if ":" in t:
            k, v = t.split(":", 1)
            d[k.strip()] = v.strip()
    return d


def graph_maps(root):
    """(rows_by_id, parents, children) from the registry's based_on edges. based_on is a comma-list,
    so an experiment can have MULTIPLE parents -> the lineage is a DAG, not a chain. Built in code
    on each call (O(N) over the registry, instant at any real scale) — the whole point is that the
    CLI walks the graph so the AGENT never spends turns traversing it. Dangling parents (id not in
    the registry) are dropped from the edge set. Persistent store = the registry itself (one source
    of truth, append-only), so there is no second graph file to drift."""
    rows = {r["id"]: r for r in reg_read(root)}
    parents, children = {}, {}
    for eid, r in rows.items():
        ps = [p for p in split_list(r.get("based_on", "")) if p in rows]
        parents[eid] = ps
        for pp in ps:
            children.setdefault(pp, []).append(eid)
    return rows, parents, children


def _bfs(adj, eid):
    """[(node, depth), ...] reachable from eid via adjacency `adj`, nearest first, deduped. In a DAG
    a node reachable by several paths is reported once, at its shortest depth."""
    out, seen, q = [], {eid}, deque((c, 1) for c in adj.get(eid, []))
    while q:
        n, d = q.popleft()
        if n in seen:
            continue
        seen.add(n)
        out.append((n, d))
        for nxt in adj.get(n, []):
            if nxt not in seen:
                q.append((nxt, d + 1))
    return out


def ancestors(root, eid, maps=None):
    _rows, parents, _children = maps or graph_maps(root)
    return _bfs(parents, eid)


def descendants(root, eid, maps=None):
    _rows, _parents, children = maps or graph_maps(root)
    return _bfs(children, eid)


def lineage_root(root, eid):
    """Deterministic single root id for wandb grouping: the oldest parentless ancestor (ids sort
    chronologically as YYYYMMDD-slug, so min = oldest). eid itself if it has no ancestors. For a
    single-parent chain this is exactly the old top-of-chain, so wandb groups don't shift."""
    _rows, parents, _children = graph_maps(root)
    reach = [eid] + [n for n, _d in _bfs(parents, eid)]
    roots = [n for n in reach if not parents.get(n)]
    return min(roots) if roots else eid


def _git(root, *a):
    r = subprocess.run(["git", "-C", str(root)] + list(a), capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def git_info(root, cfg=None):
    """(sha, dirty, offenders). dirty honors [run] dirty_ok: paths matching those globs
    ("dir/" = subtree) don't count, so migration-era repos full of declared scratch read
    "clean modulo scratch". offenders is the porcelain lines that DID count — the caller reports
    them, because "your tree is dirty" without naming the files is unactionable."""
    sha = _git(root, "rev-parse", "--short", "HEAD").strip()
    # lab-exp's OWN bookkeeping never counts. Every run appends to the registry, rewrites INDEX.md,
    # and fills out/ — so without this the first run dirties the tree and the SECOND one is refused
    # by the framework's own writes. What must be clean is the CODE that produced the result.
    # _registry.tsv* covers the registry, its .lock, and reg_write's pid-suffixed temps -- one
    # glob, so new framework-owned registry files can't dirty the tree by omission.
    allow = ["experiments/_registry.tsv*", "INDEX.md", "experiments/*/out/*", "experiments/*/out"]
    allow += (cfg or {}).get("run", {}).get("dirty_ok", []) or []
    offenders = []
    for line in _git(root, "status", "--porcelain").splitlines():
        path = line[3:].strip().strip('"')
        ok = any(path.startswith(pat) if pat.endswith("/") else
                 fnmatch.fnmatch(path, pat) or fnmatch.fnmatch(path.rsplit("/", 1)[-1], pat)
                 for pat in allow)
        if not ok:
            offenders.append(line.rstrip())
    return sha or "nogit", bool(offenders), offenders


def _module_candidates(root, mod, from_file, level):
    """Relative paths a module name could resolve to INSIDE the repo. level>0 = a relative import
    (`from . import x`), resolved against the importing file's package rather than the root."""
    base = Path("")
    if level:
        base = from_file.parent
        for _ in range(level - 1):
            base = base.parent
    parts = mod.split(".") if mod else []
    stem = base.joinpath(*parts)
    cands = [stem.with_suffix(".py"), stem / "__init__.py"]
    # Importing pkg.sub.mod also EXECUTES pkg/__init__.py and pkg/sub/__init__.py.
    for i in range(1, len(parts)):
        cands.append(base.joinpath(*parts[:i]) / "__init__.py")
    return cands


EXP_ID_RE = re.compile(r"\b\d{8}-[a-z0-9][a-z0-9-]*")


def exp_id_literals(tree):
    """Experiment ids mentioned in a module's CODE -- string constants, docstrings excluded.
    Prose citations in docstrings are good (provenance); ids reached by code are coupling."""
    doc_nodes = set()
    for node in ast.walk(tree):
        if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            body = getattr(node, "body", [])
            if body and isinstance(body[0], ast.Expr) and isinstance(getattr(body[0], "value", None), ast.Constant) \
                    and isinstance(body[0].value.value, str):
                doc_nodes.add(id(body[0].value))
    found = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and id(node) not in doc_nodes:
            found.update(EXP_ID_RE.findall(node.value))
    return found


def ancestors_of(parents, eid):
    """Transitive based_on ancestry (cycle-safe)."""
    seen, stack = set(), list(parents.get(eid, []))
    while stack:
        a = stack.pop()
        if a in seen:
            continue
        seen.add(a)
        stack.extend(parents.get(a, []))
    return seen


def lineage_families(parents, eids):
    """Collapse experiments into lineage families: two experiments are one family if they share a
    based_on root. Retries, fixes, and descendants of one question count ONCE -- the denominator
    the promotion rule actually cares about."""
    roots = {}
    for e in eids:
        anc = ancestors_of(parents, e)
        r = {a for a in anc if not parents.get(a)} or {e}
        roots[e] = r
    fam = []
    for e, r in roots.items():
        merged = [f for f in fam if f["roots"] & r]
        new = {"roots": set(r), "members": {e}}
        for f in merged:
            new["roots"] |= f["roots"]; new["members"] |= f["members"]; fam.remove(f)
        fam.append(new)
    return fam


def import_closure(root, entry):
    """Every in-repo .py file reachable from `entry` by following imports, transitively.

    Static (AST) on purpose: it runs BEFORE launch, so an unreproducible run can be refused rather
    than discovered afterwards in an append-only record. The cost is that it cannot see dynamic
    imports (importlib.import_module on a computed name, plugin registries) — this is a floor on
    what the run needs, not a proof. Paths are relative to root; files outside the repo (site
    packages, stdlib) are ignored, since git can't track those anyway."""
    seen, queue, found = set(), [entry], set()
    probed = {}          # candidate relpath -> is_file(); an NFS stat per DISTINCT path, not per import
    def probe(cand):
        k = str(cand)
        if k not in probed:
            probed[k] = (root / cand).is_file()
        return probed[k]
    while queue:
        rel = queue.pop()
        if rel in seen:
            continue
        seen.add(rel)
        f = root / rel
        if not f.is_file():
            continue
        found.add(rel)
        try:
            tree = ast.parse(f.read_text())
        except (SyntaxError, UnicodeDecodeError):
            continue    # unparseable code is the run's problem to report, not the tracker's
        for node in ast.walk(tree):
            targets = []
            if isinstance(node, ast.Import):
                targets = [(n.name, 0) for n in node.names]
            elif isinstance(node, ast.ImportFrom):
                # `from pkg.mod import name` — `name` may itself be a submodule, so try both.
                targets = [(node.module or "", node.level)]
                targets += [((node.module + "." + n.name) if node.module else n.name, node.level)
                            for n in node.names]
            for mod, level in targets:
                for cand in _module_candidates(root, mod, rel, level):
                    if probe(cand):
                        queue.append(cand)
    return found


def untracked_imports(root, entry):
    """In-repo files the run imports that git is NOT tracking — the silent reproducibility hole.

    A .gitignore'd module is invisible to `git status --porcelain`, so the tree reads CLEAN, the
    dirty check passes, and the recorded SHA omits code the run actually executed. That is strictly
    worse than the untracked-and-dirty case, which at least produces a warning."""
    tracked = set(_git(root, "ls-files", "-z").split("\0"))
    return sorted(str(p) for p in import_closure(root, entry) if str(p) not in tracked)


def archive_untracked(root, outdir, paths):
    """Copy untracked imported code into out/untracked-code/, preserving relative layout, so the
    --allow-dirty escape hatch stays reconstructible instead of merely permitted."""
    dest_base = outdir / "untracked-code"
    saved = []
    for rel in paths:
        src = root / rel
        if not src.is_file():
            continue
        dest = dest_base / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
        saved.append(rel)
    return saved


def write_dirty_patch(root, outdir, offenders):
    """Make a dirty run reproducible anyway: SHA + patch reconstructs the exact tree.

    Returns (patch_relpath_or_empty, untracked_list). `git diff HEAD` covers TRACKED modifications
    only — an untracked new module the run imports is invisible to it, and that is the dangerous
    case, so the names are returned for run-meta rather than silently omitted."""
    patch = _git(root, "diff", "HEAD")
    rel = ""
    if patch.strip():
        (outdir / "dirty.patch").write_text(patch)
        rel = "out/dirty.patch"
    untracked = [ln[3:].strip().strip('"') for ln in offenders if ln.startswith("??")]
    return rel, untracked


def agent_name():
    return os.environ.get("LAB_EXP_AGENT") or os.environ.get("USER", "unknown")


