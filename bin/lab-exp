RUN_GENERIC = '''\
"""{id} — see README.md in this directory.

Runs bare (`python run.py`) or stamped+registered via `lab-exp run {id}`.
Import shared code from the project package — check {pkg}/INDEX.md before writing new methods.
Reuse within your lineage: load_ancestor("<based_on id>") returns that experiment's lib.py
(helpers it kept main-free); promote to {pkg}/ only when a SECOND lineage needs them.
"""
import sys
from pathlib import Path

EXP = Path(__file__).resolve().parent
OUT = EXP / "out"
ROOT = EXP.parent.parent
sys.path.insert(0, str(ROOT))


def load_ancestor(eid, module="lib"):
    """Import a frozen ANCESTOR experiment's helper module by path (dir names start with digits,
    so dotted import cannot). Only ancestors -- `lab-exp run` refuses anything else."""
    import importlib.util
    p = EXP.parent / eid / f"{{module}}.py"
    spec = importlib.util.spec_from_file_location(f"anc_{{eid}}_{{module}}", p)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def main():
    OUT.mkdir(exist_ok=True)
    # TODO: implement the experiment. Write key scalars to OUT/"metrics.json".


if __name__ == "__main__":
    main()
'''

