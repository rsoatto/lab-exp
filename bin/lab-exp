MATCH = {}
KIND = None


def render(exp_dir: Path, out_dir: Path) -> list:
    import json
    out_dir.mkdir(parents=True, exist_ok=True)
    metrics = json.loads((exp_dir / "out" / "metrics.json").read_text())
    if isinstance(metrics, list):  # training-history style: chart the last record
        metrics = metrics[-1] if metrics else {}
    spec = {  # Vega-Lite: drops straight into lab-report pages
        "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
        "data": {"values": [{"metric": k, "value": v} for k, v in metrics.items()
                            if isinstance(v, (int, float))]},
        "mark": "bar",
        "encoding": {"x": {"field": "metric", "type": "nominal"},
                     "y": {"field": "value", "type": "quantitative"}},
    }
    p = out_dir / "metrics_bar.vl.json"
    p.write_text(json.dumps(spec, indent=2))
    return [p]
